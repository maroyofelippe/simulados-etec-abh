# ==========================================================
#  Sistema de Simulados Educacionais - ETEC ABH
#  Copie este arquivo para ".env" e ajuste os valores.
# ==========================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Banco de dados MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=simulados_etec_abh
DB_USER=root
DB_PASS=sua_senha_mysql

# --- TLS do banco (obrigatório em provedores gerenciados, ex.: Aiven) ---
# DB_SSL=true
# DB_CA_PATH=./database/ca.pem   # certificado CA baixado no painel do provedor

# --- Autenticação / JWT ---
# Gere uma chave forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_esta_chave_secreta_por_uma_aleatoria_e_longa
JWT_EXPIRES_IN=8h

# --- Controle de sessão ---
# Tempo (em minutos) de inatividade antes do logout automático
SESSION_TIMEOUT=30

# --- Senha inicial padrão para usuários importados via CSV ---
SENHA_PADRAO_IMPORTACAO=Etec@2025

# --- Senha inicial padrão para visitantes auto-cadastrados na Feira de Profissões ---
SENHA_PADRAO_VISITANTE_FEIRA=Visitante@2026

# --- Senha do super-perfil "root" (necessária para elevação de privilégio) ---
# Em produção use um hash; aqui é apenas didático.
ROOT_PASSWORD=RootEtec@2025

# --- Política de perda de foco durante a prova ---
# Número de saídas de foco toleradas antes de anular a questão / encerrar
MAX_PERDAS_FOCO=0

# --- Palavra-coringa anti-IA (inserida como caractere invisível nas questões) ---
PALAVRA_CORINGA=abacaxi-quantico-etec
