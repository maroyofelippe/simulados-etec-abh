<h1>Bem-vindo(a), <%= usuario.nome.split(' ')[0] %>!</h1>
<p class="metric-label">Perfil: <b><%= usuario.perfil %></b><%= usuario.is_root ? ' • ROOT ativo' : '' %></p>

<% if (usuario.perfil === 'coordenador') { %>
<div class="grid grid-6" style="margin-top:16px">
  <div class="card card-placar">
    <br>
    <div class="metric"><%= placar.turmas %></div>
    <div class="metric-label">Turmas</div>
  </div>
  <div class="card card-placar">
    <br>
    <div class="metric"><%= placar.alunos %></div>
    <div class="metric-label">Alunos</div>
  </div>
  <div class="card card-placar">
    <br>
    <div class="metric"><%= placar.unidades %></div>
    <div class="metric-label">Unidades</div>
  </div>
  <div class="card card-placar">
    <br>
    <div class="metric"><%= placar.questoes %></div>
    <div class="metric-label">Questões</div>
  </div>
  <div class="card card-placar">
    <br>
    <div class="metric"><%= placar.visitantesFeira %></div>
    <div class="metric-label">Visitantes da Feira</div>
  </div>
  <div class="card card-placar" id="root-privilegio">
    <div class="metric"><i class="fa-solid fa-<%= usuario.is_root ? 'unlock' : 'lock' %>"></i></div>
    <div class="metric-label">Privilégio root<%= usuario.is_root ? ' — ativo' : '' %></div>
    <% if (usuario.is_root) { %>
      <button class="btn btn-outline" style="margin-top:8px;width:100%;justify-content:center" onclick="rebaixar()">Desativar</button>
    <% } else { %>
      <button class="btn btn-perigo" style="margin-top:8px;width:100%;justify-content:center" onclick="elevar()">sudo su</button>
    <% } %>
    <p id="root-msg" class="metric-label" style="margin:6px 0 0"></p>
  </div>
</div>
<script>
async function elevar(){
  const senha = prompt('Digite a senha root para elevar seu privilégio:');
  if (senha === null) return;
  const r = await fetch('/root/elevar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({senha_root:senha})});
  const d = await r.json();
  document.getElementById('root-msg').textContent = d.mensagem || d.erro;
  if (r.ok) setTimeout(()=>location.reload(),800);
}
async function rebaixar(){
  const r = await fetch('/root/rebaixar',{method:'POST'});
  if (r.ok) location.reload();
}
</script>
<% } %>

<div class="grid grid-3" style="margin-top:16px">
  <a class="card" href="/dashboard"><h3><i class="fa-solid fa-chart-column"></i> Dashboard</h3><p>Estatísticas por unidade, turma e aluno.</p></a>
  <a class="card" href="/professor/simulados"><h3><i class="fa-solid fa-file-lines"></i> Simulados</h3><p>Criar e publicar provas parametrizadas.</p></a>
  <a class="card" href="/professor/questoes"><h3><i class="fa-solid fa-folder-open"></i> Banco de Questões</h3><p>Cadastrar e importar questões (CSV).</p></a>
  <% if (usuario.perfil === 'coordenador') { %>
  <a class="card" href="/admin/usuarios"><h3><i class="fa-solid fa-users"></i> Usuários</h3><p>Gestão, edição e reset de senha.</p></a>
  <a class="card" href="/admin/importar-usuarios"><h3><i class="fa-solid fa-file-import"></i> Importar Alunos</h3><p>Alimentação em massa via CSV.</p></a>
  <a class="card" href="/admin/unidades"><h3><i class="fa-solid fa-school"></i> Unidades</h3><p>Cadastro e logo institucional.</p></a>
  <a class="card" href="/admin/turmas"><h3><i class="fa-solid fa-chalkboard-user"></i> Turmas</h3><p>Gestão de turmas e períodos.</p></a>
  <% } %>
</div>
