<!DOCTYPE html>
<html lang="pt-BR" data-tema="<%= typeof tema !== 'undefined' ? tema : 'claro' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> — Simulados ETEC ABH</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Roboto+Slab:wght@100;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="/css/tema.css">
</head>
<body>
  <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo</a>
  <!--<img src="/img/logo-cps-2022.svg" alt="Centro Paula Souza" class="logo-oficial">-->
  <header class="topbar" role="banner">
    <div class="marca">
      <span class="selo">ABH</span>
      <span>Simulados Educacionais</span>
    </div>
    <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-principal" onclick="alternarMenuMobile()">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
    <nav id="nav-principal" aria-label="Navegação principal">
      <% if (typeof usuario !== 'undefined' && usuario) { %>
        <a href="/"><i class="fa-solid fa-house" aria-hidden="true"></i> Início</a>
        <% if (usuario.perfil === 'aluno' || usuario.perfil === 'visitante_feira') { %>
          <a href="/aluno/provas"><i class="fa-solid fa-file-pen" aria-hidden="true"></i> Minhas Provas</a>
        <% } else { %>
          <a href="/dashboard"><i class="fa-solid fa-chart-column" aria-hidden="true"></i> Dashboard</a>
          <a href="/professor/simulados"><i class="fa-solid fa-file-lines" aria-hidden="true"></i> Simulados</a>
          <a href="/professor/questoes"><i class="fa-solid fa-folder-open" aria-hidden="true"></i> Questões</a>
          <a href="/professor/alunos"><i class="fa-solid fa-users-gear" aria-hidden="true"></i> Meus Alunos</a>
          <% if (usuario.perfil === 'coordenador') { %>
            <div class="dropdown">
              <button class="dropdown-toggle" type="button" aria-haspopup="true" aria-expanded="false" onclick="alternarMenu(event)">
                <i class="fa-solid fa-user-shield" aria-hidden="true"></i> Admin <i class="fa-solid fa-caret-down" aria-hidden="true"></i>
              </button>
              <div class="dropdown-menu">
                <a href="/dashboard/feira"><i class="fa-solid fa-bullhorn" aria-hidden="true"></i> Captação (Feira)</a>
                <a href="/admin/usuarios"><i class="fa-solid fa-users" aria-hidden="true"></i> Usuários</a>
                <a href="/admin/aprovacoes"><i class="fa-solid fa-user-check" aria-hidden="true"></i> Aprovações de Cadastro</a>
                <a href="/admin/importar-usuarios"><i class="fa-solid fa-file-import" aria-hidden="true"></i> Importar Alunos</a>
                <a href="/admin/unidades"><i class="fa-solid fa-school" aria-hidden="true"></i> Cadastro de Unidades</a>
                <a href="/admin/turmas"><i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i> Cadastro de Turmas</a>
                <a href="/#root-privilegio"><i class="fa-solid fa-key" aria-hidden="true"></i> Modo Root</a>
              </div>
            </div>
          <% } %>
        <% } %>
        <button id="btn-tema" class="tema-toggle" aria-pressed="false" onclick="alternarTema()"><i class="fa-solid fa-moon" aria-hidden="true"></i> Escuro</button>
        <a href="/logout"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Sair (<%= usuario.nome.split(' ')[0] %>)</a>
      <% } else { %>
        <button id="btn-tema" class="tema-toggle" aria-pressed="false" onclick="alternarTema()"><i class="fa-solid fa-moon" aria-hidden="true"></i> Escuro</button>
      <% } %>
    </nav>
  </header>
  <main class="container" id="conteudo-principal" tabindex="-1">
    <%- body %>
  </main>
  <%- include('./footer') %>
  <script src="/js/tema.js"></script>

  <!-- VLibras: tradutor de Libras (Governo Federal) -->
  <div vw class="enabled">
    <div vw-access-button class="active"></div>
    <div vw-plugin-wrapper>
      <div class="vw-plugin-top-wrapper"></div>
    </div>
  </div>
  <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
  <script>new window.VLibras.Widget('https://vlibras.gov.br/app');</script>
</body>
</html>
