<h1>Minhas Provas</h1>
<% if (!simulados.length) { %>
  <div class="card" role="status"><p>Nenhum simulado disponível para sua turma no momento.</p></div>
<% } %>
<ul class="grid grid-2" style="list-style:none; margin:0; padding:0" aria-label="Lista de provas disponíveis">
<% simulados.forEach(function(s){ var p = mapa.get(s.id); %>
  <li class="card">
    <h3><%= s.titulo %></h3>
    <p class="metric-label">
      <%= s.disciplina ? s.disciplina.nome : 'Múltiplas disciplinas' %> •
      <%= s.qtd_questoes %> questões • <%= s.duracao_minutos %> min
    </p>
    <% if (p && (p.status === 'concluida' || p.status === 'expirada')) { %>
      <span class="badge mencao-B">Concluída</span>
      <a class="btn btn-outline" href="/aluno/provas/<%= p.id %>/resultado" aria-label="Ver resultado de <%= s.titulo %>">Ver resultado</a>
    <% } else if (p && p.status === 'em_andamento') { %>
      <form method="POST" action="/aluno/provas/<%= s.id %>/iniciar">
        <button class="btn btn-primario" aria-label="Continuar prova: <%= s.titulo %>">Continuar prova</button>
      </form>
    <% } else { %>
      <form method="POST" action="/aluno/provas/<%= s.id %>/iniciar"
            onsubmit="return confirm('Ao iniciar você terá apenas 1 tentativa e o cronômetro começará. Continuar?')">
        <button class="btn btn-primario" aria-label="Iniciar prova: <%= s.titulo %>">Iniciar prova</button>
      </form>
    <% } %>
  </li>
<% }); %>
</ul>
