<h1>Editar cadastro do aluno</h1>
<div class="card">
  <% if (typeof erro !== 'undefined' && erro) { %><div class="alerta alerta-erro"><%= erro %></div><% } %>
  <form method="POST" action="/professor/alunos/<%= aluno.id %>">
    <div class="grid grid-2">
      <div><label>Nome</label><input name="nome" value="<%= aluno.nome %>" required></div>
      <div><label>E-mail</label><input type="email" name="email" value="<%= aluno.email || '' %>"></div>
    </div>
    <div class="grid grid-3">
      <div><label>RM</label><input name="rm" value="<%= aluno.rm || '' %>"></div>
      <div><label>Turma</label>
        <select name="turma_id" required>
          <% turmas.forEach(function (t) { %>
            <option value="<%= t.id %>" <%= aluno.turma_id === t.id ? 'selected' : '' %>><%= t.nome %><%= t.serie ? ' — ' + t.serie : '' %><%= t.ativo ? '' : ' (inativa)' %></option>
          <% }); %>
        </select></div>
      <div><label>Período</label>
        <select name="periodo">
          <option value="">—</option>
          <% ['Manhã', 'Tarde', 'Noite', 'Integral'].forEach(function (p) { %>
            <option value="<%= p %>" <%= aluno.periodo === p ? 'selected' : '' %>><%= p %></option>
          <% }); %>
        </select></div>
    </div>
    <button class="btn btn-primario" style="margin-top:12px"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
    <a class="btn btn-outline" style="margin-top:12px" href="/professor/alunos"><i class="fa-solid fa-arrow-left"></i> Cancelar</a>
  </form>
</div>
