<h1>Disciplinas</h1>
<div class="card" style="margin-bottom:16px">
  <form method="POST" action="/admin/disciplinas">
    <div class="grid grid-2">
      <div><label>Nome</label><input name="nome" required></div>
      <div><label>Área</label><input name="area" placeholder="Linguagens / Ciências da Natureza…"></div>
    </div>
    <button class="btn btn-primario" style="margin-top:12px">Adicionar</button>
  </form>
</div>
<div class="tabela-responsiva">
<table><thead><tr><th>Disciplina</th><th>Área</th></tr></thead><tbody>
<% disciplinas.forEach(function(d){ %><tr><td><%= d.nome %></td><td><%= d.area||'—' %></td></tr><% }); %>
</tbody></table>
</div>
