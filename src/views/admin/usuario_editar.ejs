<h1>Editar Usuário</h1>
<div class="card">
  <% if (typeof erro !== 'undefined' && erro) { %><div class="alerta alerta-erro"><%= erro %></div><% } %>
  <form method="POST" action="/admin/usuarios/<%= usuarioEditado.id %>">
    <div class="grid grid-2">
      <div><label>Nome</label><input name="nome" value="<%= usuarioEditado.nome %>" required></div>
      <div><label>E-mail</label><input type="email" name="email" value="<%= usuarioEditado.email || '' %>"></div>
    </div>
    <div class="grid grid-3">
      <div><label>RM</label><input name="rm" value="<%= usuarioEditado.rm || '' %>"></div>
      <div><label>Perfil</label>
        <select name="perfil">
          <option value="aluno" <%= usuarioEditado.perfil === 'aluno' ? 'selected' : '' %>>Aluno</option>
          <option value="professor" <%= usuarioEditado.perfil === 'professor' ? 'selected' : '' %>>Professor</option>
          <option value="coordenador" <%= usuarioEditado.perfil === 'coordenador' ? 'selected' : '' %>>Coordenador</option>
          <option value="visitante_feira" <%= usuarioEditado.perfil === 'visitante_feira' ? 'selected' : '' %>>Visitante da Feira</option>
        </select></div>
      <div><label>Período</label>
        <select name="periodo">
          <option value="">—</option>
          <% ['Manhã', 'Tarde', 'Noite', 'Integral'].forEach(function (p) { %>
            <option value="<%= p %>" <%= usuarioEditado.periodo === p ? 'selected' : '' %>><%= p %></option>
          <% }); %>
        </select></div>
    </div>
    <div class="grid grid-2">
      <div><label>Turma (aluno)</label>
        <select name="turma_id">
          <option value="">— Nenhuma —</option>
          <% turmas.forEach(function (t) { %>
            <option value="<%= t.id %>" <%= usuarioEditado.turma_id === t.id ? 'selected' : '' %>><%= t.nome %><%= t.ativo ? '' : ' (inativa)' %></option>
          <% }); %>
        </select></div>
      <div><label>Situação do cadastro</label>
        <select name="status_cadastro">
          <% ['aprovado', 'auto_pendente', 'recusado'].forEach(function (s) { %>
            <option value="<%= s %>" <%= usuarioEditado.status_cadastro === s ? 'selected' : '' %>><%= s %></option>
          <% }); %>
        </select></div>
    </div>
    <div style="display:flex;align-items:center;padding:8px 0">
      <label style="display:flex;align-items:center;gap:8px;margin:0">
        <input type="checkbox" name="ativo" style="width:auto" <%= usuarioEditado.ativo ? 'checked' : '' %>>
        Usuário ativo
      </label>
    </div>
    <div id="bloco-turmas-professor" <%= usuarioEditado.perfil === 'professor' ? '' : 'hidden' %>>
      <label>Turmas que leciona (professor)</label>
      <select name="turmas_lecionadas" multiple size="6" style="min-height:140px">
        <% turmas.forEach(function (t) { %>
          <option value="<%= t.id %>" <%= turmasLecionadasIds.indexOf(t.id) !== -1 ? 'selected' : '' %>><%= t.nome %><%= t.serie ? ' — ' + t.serie : '' %><%= t.ativo ? '' : ' (inativa)' %></option>
        <% }); %>
      </select>
      <p class="metric-label">Segure Ctrl (ou Cmd) para selecionar várias. O professor poderá corrigir o cadastro dos alunos dessas turmas.</p>
    </div>
    <button class="btn btn-primario" style="margin-top:12px"><i class="fa-solid fa-floppy-disk"></i> Salvar alterações</button>
    <a class="btn btn-outline" style="margin-top:12px" href="/admin/usuarios"><i class="fa-solid fa-arrow-left"></i> Cancelar</a>
  </form>

  <% if (typeof usuario !== 'undefined' && usuario && usuario.is_root) { %>
    <hr style="margin:20px 0;border-color:var(--borda)">
    <h3 style="color:var(--cancelado)">Zona de risco (root)</h3>
    <p class="metric-label">
      Excluir remove definitivamente este usuário, suas sessões de login
      <% if (provasRealizadas > 0) { %>e <b><%= provasRealizadas %></b> prova(s) simulada(s) já realizada(s) (com respostas, resultado e histórico de foco)<% } %>.
      Questões, simulados e textos de apoio que ele tenha criado são preservados (só ficam sem autor).
      <b>Esta ação não pode ser desfeita.</b>
    </p>
    <form method="POST" action="/admin/usuarios/<%= usuarioEditado.id %>/excluir"
          onsubmit="return confirm('Excluir definitivamente este usuário<%= provasRealizadas > 0 ? ' e ' + provasRealizadas + ' prova(s) simulada(s) dele' : '' %>? Esta ação não pode ser desfeita.');">
      <button type="submit" class="btn" style="background:var(--cancelado);color:#fff"><i class="fa-solid fa-trash"></i> Excluir usuário</button>
    </form>
  <% } %>
</div>
<script>
  (function () {
    var perfil = document.querySelector('[name="perfil"]');
    var bloco = document.getElementById('bloco-turmas-professor');
    perfil.addEventListener('change', function () {
      bloco.hidden = perfil.value !== 'professor';
    });
  })();
</script>
